        tween(espThumb, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Position = UDim2.new(0, 3, 0.5, 0)
        })
        ClearAllESP()
    end
end)

local function applyESP(target, labelText, color)
    if activeESP[target] then return end

    local espFolder = Instance.new("Folder")
    espFolder.Name = "Akira_ESP_Holder"
    espFolder.Parent = target

    local highlight = Instance.new("Highlight")
    highlight.Name = "AkiraHighlight"
    highlight.FillColor = color
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.55
    highlight.OutlineTransparency = 0
    highlight.Adornee = target
    highlight.Parent = espFolder

    local bb = Instance.new("BillboardGui")
    bb.Name = "AkiraBillboard"
    bb.Size = UDim2.new(0, 150, 0, 40)
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.AlwaysOnTop = true

    local targetPart = target:FindFirstChild("HumanoidRootPart") or target:FindFirstChildWhichIsA("BasePart")
    if not targetPart then
        espFolder:Destroy()
        return
    end
    bb.Adornee = targetPart
    bb.Parent = espFolder

    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.fromScale(1, 1)
    txt.BackgroundTransparency = 1
    txt.Font = Enum.Font.FredokaOne
    txt.TextSize = 11
    txt.TextColor3 = color
    txt.TextStrokeTransparency = 0.2
    txt.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    txt.Text = labelText
    txt.Parent = bb

    activeESP[target] = espFolder
end

task.spawn(function()
    while true do
        task.wait(0.4)
        if ESPEnabled then
            local myChar = Player.Character
            local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

            for _, model in ipairs(workspace:GetChildren()) do
                if model:IsA("Model") and model ~= myChar then
                    local hum = model:FindFirstChildOfClass("Humanoid")
                    local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso")
                    
                    if hum and root and not Players:GetPlayerFromCharacter(model) then
                        if not activeESP[model] then
                            applyESP(model, "👹 បិសាច (MONSTER)", Color3.fromRGB(255, 60, 60))
                        end
                        if myRoot and activeESP[model] then
                            local bb = activeESP[model]:FindFirstChild("AkiraBillboard")
                            local lbl = bb and bb:FindFirstChildOfClass("TextLabel")
                            if lbl then
                                local dist = math.floor((myRoot.Position - root.Position).Magnitude)
                                lbl.Text = string.format("👹 បិសាច [%dm]", dist)
                            end
                        end
                    end
                end
            end

            for _, item in ipairs(workspace:GetDescendants()) do
                if item:IsA("BasePart") or item:IsA("Model") then
                    local name = string.lower(item.Name)
                    if string.find(name, "egg") and not item:IsDescendantOf(myChar) then
                        local targetObj = item:IsA("Model") and item or item.Parent
                        if targetObj and not activeESP[targetObj] then
                            applyESP(targetObj, "🥚 EGG", Color3.fromRGB(255, 215, 0))
                        end
                        if myRoot and activeESP[targetObj] then
                            local rootPart = targetObj:FindFirstChildWhichIsA("BasePart")
                            local bb = activeESP[targetObj]:FindFirstChild("AkiraBillboard")
                            local lbl = bb and bb:FindFirstChildOfClass("TextLabel")
                            if lbl and rootPart then
                                local dist = math.floor((myRoot.Position - rootPart.Position).Magnitude)
                                lbl.Text = string.format("🥚 EGG [%dm]", dist)
                            end
                        end
                    end
                end
            end

            for obj, folder in pairs(activeESP) do
                if not obj.Parent then
                    folder:Destroy()
                    activeESP[obj] = nil
                end
            end
        end
    end
end)

