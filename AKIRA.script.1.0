local function getStealPrompt()
    local promptPart = workspace:FindFirstChild("SmartPromptPart")[span_2](start_span)[span_2](end_span)
    local prompt = promptPart and promptPart:FindFirstChild("CarryAreaEgg")[span_3](start_span)[span_3](end_span)
    if prompt and prompt:IsA("ProximityPrompt") then
        prompt.HoldDuration = 0[span_4](start_span)[span_4](end_span)
        prompt.RequiresLineOfSight = false[span_5](start_span)[span_5](end_span)
        return prompt
    end
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("ProximityPrompt") and (v.Name == "CarryAreaEgg" or string.find(string.lower(v.ActionText), "steal")) then[span_6](start_span)[span_6](end_span)
            v.HoldDuration = 0[span_7](start_span)[span_7](end_span)
            return v
        end
    end
    return nil
end

