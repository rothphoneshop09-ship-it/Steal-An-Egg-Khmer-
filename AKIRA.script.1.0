end

local function getPlotSafePosition()
    local spawnLoc = workspace:FindFirstChildOfClass("SpawnLocation")[span_11](start_span)[span_11](end_span)
    if spawnLoc then
        return spawnLoc.Position + Vector3.new(0, 4, 0)[span_12](start_span)[span_12](end_span)
    end
    
    local plots = workspace:FindFirstChild("Plots")[span_13](start_span)[span_13](end_span)
    if plots then
        for _, plot in ipairs(plots:GetChildren()) do[span_14](start_span)[span_14](end_span)
            local isMyPlot = false
            for _, desc in ipairs(plot:GetDescendants()) do[span_15](start_span)[span_15](end_span)
                if desc:IsA("TextLabel") and string.find(desc.Text, Player.Name) then[span_16](start_span)[span_16](end_span)
                    isMyPlot = true
                    break
                end
            end
            if isMyPlot then
                local spawnPoint = plot:FindFirstChild("SpawnPoint", true)[span_17](start_span)[span_17](end_span)
                if spawnPoint and spawnPoint:IsA("BasePart") then[span_18](start_span)[span_18](end_span)
                    return spawnPoint.Position + Vector3.new(0, 4, 0)[span_19](start_span)[span_19](end_span)
                end
                return plot:GetPivot().Position[span_20](start_span)[span_20](end_span)
            end
        end
    end
    return Vector3.new(0, 50, 0)
end

local function getBestEggToSteal()
    if not EggStateModule or type(EggStateModule.ReadFieldEggs) ~= "function" then[span_21](start_span)[span_21](end_span)
        return nil
    end

    local success, eggData = pcall(EggStateModule.ReadFieldEggs)[span_22](start_span)[span_22](end_span)
    if not success or type(eggData) ~= "table" or not eggData.Records then[span_23](start_span)[span_23](end_span)
        return nil
    end

    local targetEgg = nil
    local highestEarn = -1

    for _, egg in pairs(eggData.Records) do[span_24](start_span)[span_24](end_span)
        if egg.State == "Slot" or egg.State == "Dropped" then[span_25](start_span)[span_25](end_span)
            if not egg.CarrierUserId or egg.CarrierUserId == 0 or egg.CarrierUserId == Player.UserId then[span_26](start_span)[span_26](end_span)
                local eggPos = egg.BottomCFrame or egg.BoundsCFrame or egg.CFrame[span_27](start_span)[span_27](end_span)
                if typeof(eggPos) == "CFrame" then
                    eggPos = eggPos.Position[span_28](start_span)[span_28](end_span)
                end

                if eggPos then
                    local earnRate = tonumber(egg.MoneyPerSecond) or 1[span_29](start_span)[span_29](end_span)
                    if earnRate > highestEarn then
                        highestEarn = earnRate
                        targetEgg = {
                            Record = egg,
                            Position = eggPos,
                            Earn = earnRate
                        }
                    end
                end
            end
        end
    end

    return targetEgg
end

local autoStealTarget = nil
task.spawn(function()
    while true do
        task.wait(0.1)
        if StealConfig.Enabled then
            local char = Player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")

            if root and hum and hum.Health > 0 then
                local carrying = isDropButtonVisible()

                if not carrying then
                    if not autoStealTarget or not autoStealTarget.Position then
                        autoStealTarget = getBestEggToSteal()
                    end

                    if autoStealTarget and autoStealTarget.Position then
                        stcStatus.Text = "ស្ថានភាព៖ រត់ទៅយកពង..."
                        local moveDir = (autoStealTarget.Position - root.Position)
                        local dist = moveDir.Magnitude

                        if dist > 4 then
                            local targetVel = Vector3.new(moveDir.X, 0, moveDir.Z).Unit * StealConfig.TravelSpeed
                            root.AssemblyLinearVelocity = Vector3.new(targetVel.X, root.AssemblyLinearVelocity.Y, targetVel.Z)
                        else
                            local prompt = getStealPrompt()
                            if prompt then
                                triggerStealPrompt(prompt)
                            end
                            task.wait(0.2)
                            autoStealTarget = nil
                        end
                    else
                        stcStatus.Text = "ស្ថានភាព៖ គ្មានពងត្រូវលួច"
                    end
                else
                    stcStatus.Text = "ស្ថានភាព៖ កំពុងយកពងទៅដី..."
                    local safePos = getPlotSafePosition()
                    local returnDir = (safePos - root.Position)
                    local safeDist = Vector3.new(returnDir.X, 0, returnDir.Z).Magnitude

                    if safeDist > 8 then
                        local returnVel = Vector3.new(returnDir.X, 0, returnDir.Z).Unit * StealConfig.TravelSpeed
                        root.AssemblyLinearVelocity = Vector3.new(returnVel.X, root.AssemblyLinearVelocity.Y, returnVel.Z)
                    else
                        root.AssemblyLinearVelocity = Vector3.zero
                    end
                end
            end
        else
            autoStealTarget = nil
        end
    end
end)

